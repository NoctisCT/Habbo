# ============================================================
# Habbo Project - .gitignore
# ============================================================

# ----- Installers & Commercial Software -----
# JDK installer (~205 MB), Navicat portable (~160 MB)
# These exceed GitHub's 100 MB file limit and can be re-downloaded
1- Install/

# ----- Dependencies (reinstallable via package managers) -----
**/node_modules/
**/vendor/

# ----- MySQL binary data -----
# Raw binary data changes on every write; use PackAIO-V4.sql for DB backup
xampp/mysql/data/

# ----- Build artifacts -----
**/dist/
**/build/

# ----- XAMPP runtime & logs -----
xampp/tmp/
xampp/xampp-control.log
xampp/apache/logs/
xampp/mysql/logs/
xampp/php/logs/

# ----- OS files -----
Thumbs.db
Desktop.ini
.DS_Store

# ----- IDE files -----
.idea/
*.suo
*.user
*.sln.docstates

# ----- Misc -----
*.log
*.cache
