# ============================================================
# Habbo Project - .gitignore
# ============================================================

# ----- Installers & Commercial Software -----
# JDK installer (~205 MB), Navicat portable (~160 MB)
# These exceed GitHub's 100 MB file limit and can be re-downloaded
1- Install/

# ----- Dependencies (reinstallable via package managers) -----
**/node_modules/
**/vendor/

# ----- XAMPP Runtime & Database Binaries -----
# Exclude the XAMPP runtime programs entirely
xampp/*
# EXCEPT htdocs which contains our custom code
!xampp/htdocs/

# ----- Heavy Binary Assets (SWF / Nitro) -----
# We exclude these so the repo stays light and pushable. 
# They contain 300,000+ files and we only care about code.
xampp/htdocs/public/nitro-assets/
xampp/htdocs/public/swf/
xampp/htdocs/swf/
xampp/htdocs/nitro-assets/

# ----- Build artifacts -----
**/dist/
**/build/

# ----- OS files -----
Thumbs.db
Desktop.ini
.DS_Store

# ----- IDE files -----
.idea/
*.suo
*.user
*.sln.docstates

# ----- Misc -----
*.log
*.cache
Emulator/logging/debug.txt
Emulator/CreditBridge/classes/
avatar-sync-mvp/src/main/java/com/neah/avatarsync/*.bak*
avatar-sync-mvp/src/main/java/com/neah/avatarsync/*.STABLE-*
**/target/
*.class
*.bak-*
*.backup-*
*.roto-*
