    /*
     * ============================================================
     * CREAR LINK
     * ============================================================
     */
    private synchronized String link(
            Habbo leader,
            Habbo follower) {

        if (leader == null
                || follower == null) {

            return "No se pudo crear el vínculo.";
        }

        final int leaderId = leader.getHabboInfo().getId();

        final int followerId = follower.getHabboInfo().getId();

        if (leaderId == followerId) {

            return "No puedes sincronizarte contigo mismo.";
        }

        final Room room = leader.getHabboInfo()
                .getCurrentRoom();

        if (room == null
                || follower.getHabboInfo()
                        .getCurrentRoom() != room) {

            return "Los dos avatares deben estar en la misma sala.";
        }

        if (participantToLeader
                .containsKey(leaderId)) {

            return "Ya estás en una sincronización. Usa :unsync primero.";
        }

        if (participantToLeader
                .containsKey(followerId)) {

            return follower
                    .getHabboInfo()
                    .getUsername()
                    + " ya está en otra sincronización.";
        }

        final SyncLink link = new SyncLink(
                room.getId(),
                leaderId,
                followerId);

        linksByLeader.put(
                leaderId,
                link);

        participantToLeader.put(
                leaderId,
                leaderId);

        participantToLeader.put(
                followerId,
                leaderId);

        follower.whisper(
                "Ahora estás sincronizado con "
                        + leader
                                .getHabboInfo()
                                .getUsername()
                        + ".");

        return "Sincronización creada: tú controlas los movimientos de "
                + follower
                        .getHabboInfo()
                        .getUsername()
                + ".";
    }

    /*
     * ============================================================
     * ELIMINAR LINK
     * ============================================================
     */
    private synchronized boolean unlinkParticipant(
            int participantId,
            boolean notifyOther) {

        final Integer leaderId = participantToLeader.get(
                participantId);

        if (leaderId == null) {
            return false;
        }

        final SyncLink link = linksByLeader.remove(
                leaderId);

        if (link == null) {

            participantToLeader.remove(
                    participantId);

            return false;
        }

        participantToLeader.remove(
                link.leaderId);

        participantToLeader.remove(
                link.followerId);

        if (notifyOther) {

            Habbo leader = Emulator
                    .getGameEnvironment()
                    .getHabboManager()
                    .getHabbo(
                            link.leaderId);

            Habbo follower = Emulator
                    .getGameEnvironment()
                    .getHabboManager()
                    .getHabbo(
                            link.followerId);

            if (leader != null
                    && leader
                            .getHabboInfo()
                            .getId() != participantId
                    && leader
                            .getRoomUnit()
                            .isInRoom()) {

                leader.whisper(
                        "La sincronización de avatares ha terminado.");
            }

            if (follower != null
                    && follower
                            .getHabboInfo()
                            .getId() != participantId
                    && follower
                            .getRoomUnit()
                            .isInRoom()) {

                follower.whisper(
                        "La sincronización de avatares ha terminado.");
            }
        }

        return true;
    }

    /*
     * ============================================================
     * LINK DATA
     * ============================================================
     */
    private static final class SyncLink {

        private final int roomId;
        private final int leaderId;
        private final int followerId;

        private SyncLink(
                int roomId,
                int leaderId,
                int followerId) {

            this.roomId = roomId;
            this.leaderId = leaderId;
            this.followerId = followerId;
        }
    }

    /*
     * ============================================================
     * :SYNC
     * ============================================================
     */
    private static final class SyncCommand
            extends Command {

        private final AvatarSyncPlugin plugin;

        private SyncCommand(
                AvatarSyncPlugin plugin) {

            super(
                    null,
                    new String[] {
                            "sync",
                            "sincronizar"
                    });

            this.plugin = plugin;
        }

        @Override
        public boolean handle(
                GameClient gameClient,
                String[] params) throws Exception {

            final Habbo leader = gameClient.getHabbo();

            final Room room = leader
                    .getHabboInfo()
                    .getCurrentRoom();

            if (room == null) {
                return true;
            }

            if (params.length < 2) {

                leader.whisper(
                        "Uso: :sync <usuario>");

                return true;
            }

            final Habbo follower = room.getHabbo(
                    params[1]);

            if (follower == null) {

                leader.whisper(
                        "Ese usuario no está en la sala.");

                return true;
            }

            leader.whisper(
                    plugin.link(
                            leader,
                            follower));

            return true;
        }
    }

    /*
     * ============================================================
     * :UNSYNC
     * ============================================================
     */
    private static final class UnsyncCommand
            extends Command {

        private final AvatarSyncPlugin plugin;

        private UnsyncCommand(
                AvatarSyncPlugin plugin) {

            super(
                    null,
                    new String[] {
                            "unsync",
                            "desincronizar"
                    });

            this.plugin = plugin;
        }

        @Override
        public boolean handle(
                GameClient gameClient,
                String[] params) throws Exception {

            final Habbo habbo = gameClient.getHabbo();

            final boolean removed = plugin.unlinkParticipant(
                    habbo
                            .getHabboInfo()
                            .getId(),
                    true);

            habbo.whisper(
                    removed
                            ? "Sincronización terminada."
                            : "No estás en ninguna sincronización.");

            return true;
        }
    }
